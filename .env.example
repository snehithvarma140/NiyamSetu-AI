# ==============================================================================
# NiyamSetu AI — Environment Variable Template
# Copy values into Vercel (Frontend) and Render (Backend) dashboards.
# NEVER commit real secrets, API keys, or service-role keys into Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND SERVER (Render Web Service — PRIVATE, NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Strong random secret (>= 32 chars) used to sign NiyamSetu session tokens
SESSION_SECRET=""

# Required for all Gemini AI features (JanSetu QA, FormSathi OCR, Maps Grounding, Live Voice)
GEMINI_API_KEY=""

# Comma-separated list of authorized frontend origins for CORS & WebSocket /live
# Example: https://niyamsetu-ai.vercel.app,https://www.niyamsetu.in
CORS_ALLOWED_ORIGINS=""
FRONTEND_URL=""
APP_URL=""
# Set to "true" only if you need ephemeral *.vercel.app preview branches allowed
CORS_ALLOW_VERCEL_PREVIEWS="false"

# MUST be "false" in production to disable one-click demo login and demo reset endpoints
ENABLE_DEMO_AUTH="false"

# Persistence: Option A — Render Persistent Disk directory (e.g., /var/data)
NIYAMSETU_DATA_DIR=""

# Persistence: Option B — Supabase PostgreSQL (authoritative remote state + analytics)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Firebase Web API Key / Platform Admin overrides for /api/auth/google-sync
FIREBASE_WEB_API_KEY=""
PLATFORM_ADMIN_EMAILS=""

# Optional server fallback key returned by /api/maps/config when VITE_GOOGLE_MAPS_API_KEY is unset
GOOGLE_MAPS_API_KEY=""

# ------------------------------------------------------------------------------
# FRONTEND CLIENT (Vercel — PUBLIC, bundled into browser JS via Vite)
# ------------------------------------------------------------------------------
# Render Backend base HTTPS URL (NO trailing slash), e.g. https://niyamsetu-api.onrender.com
VITE_API_BASE_URL=""

# Optional explicit WebSocket origin; defaults automatically to wss:// derived from VITE_API_BASE_URL
VITE_WS_BASE_URL=""

# MUST be "false" in production builds to hide one-click demo role cards
VITE_ENABLE_DEMO_AUTH="false"

# Google Maps Platform Browser API Key (restrict by HTTP Referrer to your Vercel domain)
VITE_GOOGLE_MAPS_API_KEY=""

# Optional Frontend Supabase Realtime config (public anon key only — never service_role)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Optional Frontend Firebase config overrides (falls back to firebase-applet-config.json if unset)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
